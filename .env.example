# SimLinux Configuration

# LLM API Settings (DeepSeek or any OpenAI-compatible API)
OPENAI_API_KEY=sk-your-api-key-here
BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# SSH Server Settings
SSH_HOST=0.0.0.0
SSH_PORT=2222
SSH_HOST_KEY=ssh_host_key

# SSH Authentication Credentials (for testing/learning)
SSH_USERNAME=root
SSH_PASSWORD=123

# Default Distribution (ubuntu-22.04, arch, debian-12, alpine-3.19)
DEFAULT_DISTRO=ubuntu-22.04

# Hostname displayed in terminal
HOSTNAME=simlinux

# Simulated Hardware Specs
CPU_CORES=2
CPU_MODEL=Intel(R) Core(TM) Virtual CPU @ 2.80GHz
MEMORY_GB=8
DISK_GB=40
